            <key>script</key>
            <value>-- Probe: report the layout's own idea of its size, and count resize events.
local resizes = 0

local function readout()
  local r = root.frame
  local s = self.frame
  self.properties.text = string.format(
    "root %dx%d | self %dx%d | resize events: %d", r.w, r.h, s.w, s.h, resizes)
end

function init()
  readout()
end

function resize()
  resizes = resizes + 1
  readout()
end

function update()
  readout()
end</value>
